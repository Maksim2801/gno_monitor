# Application
APP_NAME=GNO Monitor
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
POSTGRES_USER=gno
POSTGRES_PASSWORD=gno_secure_password
POSTGRES_DB=gno_monitor
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://gno:gno_secure_password@db:5432/gno_monitor

# Admin bootstrap (used only when DB has no admin user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_FULL_NAME=Системный администратор

# Analytics
ANALYTICS_INTERVAL_MINUTES=15
PREDICTION_HORIZON_DAYS=7
RISK_THRESHOLD_MEDIUM=0.35
RISK_THRESHOLD_HIGH=0.65
ANOMALY_SCORE_THRESHOLD=0.55

# Seed
SEED_ON_STARTUP=true
